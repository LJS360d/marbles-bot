DISCORD_BOT_TOKEN=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_SERVER_INVITE_URL=
DISCORD_BOT_INVITE_URL=
OWNER_USER_IDS=
DISCORD_ACTIVITY_ENABLED=false
DISCORD_ACTIVITY_CLIENT_ID=
DISCORD_ACTIVITY_CLIENT_SECRET=
DISCORD_ACTIVITY_REDIRECT_URI=https://<public-host>/
DISCORD_ACTIVITY_ENTRY_COMMAND_NAME=play
DISCORD_ACTIVITY_ENTRY_COMMAND_DESCRIPTION=Open the Marbles embedded activity
DISCORD_ACTIVITY_ALLOWED_ORIGINS=https://discord.com,https://ptb.discord.com,https://canary.discord.com
DISCORD_ACTIVITY_URL_MAPPINGS=/bucket=<ASSETS_BASE_URL>
DISCORD_ACTIVITY_SESSION_SAME_SITE=None
DISCORD_ACTIVITY_SESSION_SECURE=true
DISCORD_PUBLIC_KEY=

# Custom domain url for assets (CDN or bucket URL)
ASSETS_BASE_URL=

# Name of the bucket
S3_BUCKET=
# Host of the bucket, without the scheme (https:// or http://)
S3_HOST=

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PATH_STYLE=true

# --- Production / Railway (SQLite + R2) ---
# RELEASE_ROLE=all | web | bot — optional: defaults from RELEASE_NAME (bot→bot, web→web, else all)
RELEASE_ROLE=all
# SQLite file (e.g. on a mounted volume in Docker/Railway)
DATABASE_PATH=/app/data/marbles_prod.db
POOL_SIZE=5
# mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname (no scheme), e.g. marbles.up.railway.app — used for :url and links.
# Railway exposes RAILWAY_PUBLIC_DOMAIN; PHX_HOST wins if both are set.
PHX_HOST=
PHX_SCHEME=https
PHX_URL_PORT=443

# Docker / Railway image — which OTP release to build (marbles_umbrella | web | bot)
RELEASE_NAME=marbles_umbrella
