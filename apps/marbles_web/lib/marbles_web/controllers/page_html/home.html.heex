<Layouts.app flash={@flash} current_scope={nil}>
  <div id="home-page" class="animated-gradient min-h-screen flex flex-col p-4">
    <div class="flex flex-1 flex-col items-center justify-center min-h-0 w-full">
      <div class="backdrop-blur-lg bg-white/10 dark:bg-black/10 rounded-2xl shadow-2xl border border-white/20 w-full max-w-6xl overflow-hidden">
        <!-- Event Banner Section (Conditional) -->
        <div class="hidden" id="event-banner-placeholder">
          <!-- Will be populated when events system is implemented -->
        </div>
        
<!-- Main Content -->
        <div class="flex flex-col lg:flex-row bg-base-200/70">
          <!-- Left Column: Logo and Main Actions -->
          <div class="flex-1 p-8 lg:p-12 flex flex-col items-center lg:items-start">
            <!-- Logo/Title Section -->
            <div class="text-center lg:text-left mb-8 animate-fade-in">
              <div class="flex items-center justify-center lg:justify-start gap-4 mb-4">
                <div class="w-16 h-16 rounded-full bg-primary/20 border-4 border-primary animate-pulse-slow" />
                <div class="w-12 h-12 rounded-full bg-secondary/30 border-4 border-secondary animate-pulse-slow delay-300" />
                <div class="w-20 h-20 rounded-full bg-accent/20 border-4 border-accent animate-pulse-slow delay-600" />
              </div>
              <h1 class="text-5xl lg:text-6xl font-bold tracking-tight bg-linear-to-r from-primary to-accent bg-clip-text text-transparent">
                Marbles
              </h1>
              <p class="text-base-content/80 text-lg mt-4 max-w-md">
                Collect rare marbles, race them against others, and climb the global leaderboard.
              </p>
            </div>
            
<!-- Main Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 mb-8 w-full max-w-md">
              <.link
                class="btn btn-primary btn-lg rounded-full px-8 flex-1 glow-primary hover:scale-105 transition-transform"
                href={if @current_user, do: "/gacha", else: "/login"}
              >
                <span class="flex items-center gap-2">
                  <.icon name="hero-bolt" class="size-5" /> Quick Race
                </span>
              </.link>
              <.link
                class="btn btn-secondary btn-lg rounded-full px-8 flex-1 hover:scale-105 transition-transform"
                href={if @current_user, do: "/gacha", else: "/login"}
              >
                <span class="flex items-center gap-2">
                  <.icon name="hero-gift" class="size-5" /> Get Marbles
                </span>
              </.link>
            </div>
            
<!-- Auxiliary Buttons -->
            <div class="flex flex-wrap gap-3 mb-8">
              <.link
                class="btn btn-outline btn-sm rounded-full px-4"
                href="/events"
              >
                <.icon name="hero-calendar" class="size-4" /> Calendar
              </.link>
              <!-- Discord buttons will be conditionally rendered when env vars are set -->
              <button
                :if={!is_nil(@discord_server_invite)}
                class="btn btn-outline btn-sm rounded-full px-4"
              >
                <.icon name="hero-chat-bubble-left-right" class="size-4" /> Discord Server
              </button>
              <button
                :if={!is_nil(@discord_bot_invite)}
                class="btn btn-outline btn-sm rounded-full px-4"
              >
                <.icon name="hero-plus" class="size-4" /> Invite Bot
              </button>
            </div>
            
<!-- Authentication Section -->
            <div class="w-full max-w-md">
              <%= if @current_user do %>
                <div class="flex items-center justify-between p-4 bg-base-100/50 rounded-xl">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center">
                      <.icon name="hero-user" class="size-5 text-primary" />
                    </div>
                    <div>
                      <p class="font-medium">
                        {Marbles.Accounts.primary_display_name(@current_user)}
                      </p>
                      <p class="text-sm text-base-content/70">Ready to race!</p>
                    </div>
                  </div>
                  <a href={~p"/admin"} class="btn btn-ghost btn-sm">
                    Dashboard
                  </a>
                </div>
              <% else %>
                <div class="text-center lg:text-left">
                  <p class="text-base-content/70 mb-3">Sign in to start racing</p>
                  <a href={~p"/login"} class="btn btn-primary rounded-sm px-6">
                    <svg class="size-5" viewBox="0 0 127.14 96.36" fill="currentColor">
                      <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,56.84,124.09,33.37,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z" />
                    </svg>
                    Log in with Discord
                  </a>
                </div>
              <% end %>
            </div>
          </div>
          
<!-- Right Column: Marketing Carousel -->
          <div class="flex-1 p-8 lg:p-12 border-t lg:border-t-0 lg:border-l border-base-300">
            <div class="h-full flex flex-col">
              <h3 class="text-lg font-semibold mb-4">Featured</h3>
              <div class="flex-1 overflow-hidden rounded-xl">
                <!-- Carousel placeholder -->
                <div class="h-full bg-linear-to-br from-base-200 to-base-300 rounded-xl flex items-center justify-center">
                  <div class="text-center p-8">
                    <div class="w-24 h-24 rounded-full bg-primary/10 mx-auto mb-4 flex items-center justify-center">
                      <.icon name="hero-sparkles" class="size-12 text-primary/50" />
                    </div>
                    <p class="text-base-content/70">New packs and events coming soon!</p>
                    <p class="text-sm text-base-content/50 mt-2">
                      Stay tuned for exciting updates
                    </p>
                  </div>
                </div>
              </div>
              <div class="flex justify-center gap-2 mt-4">
                <%= for i <- 1..3 do %>
                  <div class="w-2 h-2 rounded-full bg-base-300"></div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <footer
      id="home-legal-footer"
      class="shrink-0 mt-6 pb-4 text-center text-xs text-base-content/55 tracking-wide"
    >
      <nav
        class="inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1"
        aria-label="Legal"
      >
        <.link
          navigate={~p"/privacy-policy"}
          class="hover:text-base-content/90 underline-offset-2 hover:underline transition-colors"
        >
          Privacy Policy
        </.link>
        <span class="text-base-content/30 select-none" aria-hidden="true">·</span>
        <.link
          navigate={~p"/terms-of-service"}
          class="hover:text-base-content/90 underline-offset-2 hover:underline transition-colors"
        >
          Terms of Service
        </.link>
      </nav>
    </footer>
  </div>
</Layouts.app>
